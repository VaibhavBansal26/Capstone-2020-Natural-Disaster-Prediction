# Copy to .env and fill in what you need. Every value is optional:
# features whose keys are missing are shown as "not configured" in the UI.

# --- Application ---
NDP_DEBUG=false
NDP_ENABLE_COVID=true             # COVID-19 pages (live totals, 2020 case curve, test centres)

# --- Live weather (OpenWeatherMap, free tier) ---
NDP_OPENWEATHER_API_KEY=

# --- Alerts: email over SMTP (use an app password, never your account password) ---
NDP_SMTP_HOST=smtp.gmail.com
NDP_SMTP_PORT=465
NDP_SMTP_USER=
NDP_SMTP_PASSWORD=
NDP_ALERT_FROM_EMAIL=
NDP_ALERT_TO_EMAIL=

# --- Claude-powered features: assistant, post triage, alert translation ---
ANTHROPIC_API_KEY=
NDP_ANTHROPIC_MODEL=claude-opus-5-5   # claude-sonnet-5-5 is cheaper for a public site

# --- Alert behaviour ---
NDP_WATCH_QUAKES=false            # true: watch USGS and alert for new strong earthquakes
NDP_WATCH_MIN_MAGNITUDE=6.0
NDP_WATCH_INTERVAL_SECONDS=300
NDP_ALERTS_DRY_RUN=false          # true: compose and check channels but send nothing (safe for testing)
NDP_ALERT_RADIUS_KM=15            # search radius for hospitals and police around the epicentre
NDP_ALERTS_PASSCODE=              # set on a public site: sending an alert then needs this passcode
NDP_ALERTS_ALLOW_CUSTOM_PHONE=false   # true lets the alert form pick the SMS recipient (leave off)

# --- Alerts: SMS / WhatsApp over Twilio ---
NDP_TWILIO_ACCOUNT_SID=
NDP_TWILIO_AUTH_TOKEN=
NDP_TWILIO_FROM_NUMBER=
NDP_ALERT_TO_NUMBER=

# --- Locations (defaults are inside the repository; point at a mounted volume when deploying) ---
# NDP_DATA_DIR=data/raw
# NDP_MODELS_DIR=models
# NDP_GENERATED_DIR=src/ndp/static/generated
# NDP_STATE_DIR=state
# NDP_GUIDANCE_DIR=data/guidance
# NDP_ASSISTANT_MAX_TOOL_ROUNDS=6
